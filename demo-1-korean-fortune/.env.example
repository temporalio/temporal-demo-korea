# Copy this file to `.env` and fill in the values.
#   cp .env.example .env

# ── Fortune LLM provider ──────────────────────────────────────────────────
# Which backend generates the fortune reading:
#   openai  -> OpenAI API (requires OPENAI_API_KEY below)
#   claude  -> local Claude Code CLI  (`claude -p`)   -- no API key needed
#   cursor  -> local Cursor CLI       (`agent -p`)    -- no API key needed
# If unset: uses `openai` when OPENAI_API_KEY is set, otherwise `claude`.
# FORTUNE_PROVIDER=claude

# Optional overrides for local-AI mode:
# CLAUDE_CLI_BIN=claude     # Claude Code CLI binary/path
# CURSOR_CLI_BIN=agent      # Cursor CLI binary/path
# LOCAL_AI_TIMEOUT=90       # seconds to wait for the CLI

# ── OpenAI ────────────────────────────────────────────────────────────────
# Optional. Used only when the provider resolves to `openai`. Without any
# provider available, the demo falls back to a mock fortune generator.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# ── Temporal connection ───────────────────────────────────────────────────
# Leave TEMPORAL_API_KEY empty to use a local `temporal server start-dev`
# instance. Set it to connect to Temporal Cloud instead.

# --- Option A: Local dev server (default) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# --- Option B: Temporal Cloud ---
# Uncomment and fill in these values (and set your API key above) to use Cloud.
# TEMPORAL_ADDRESS=<your-namespace>.<account-id>.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=<your-namespace>.<account-id>
# TEMPORAL_API_KEY=<your-temporal-cloud-api-key>
