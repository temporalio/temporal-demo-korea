setup:
    python3 -m venv .venv && .venv/bin/pip install -e ".[dev]"

worker:
    .venv/bin/python -m src.worker

# Local-AI mode: generate fortunes with a local coding-agent CLI instead of
# the OpenAI API. Defaults to Claude Code; pass `cursor` to use the Cursor CLI.
#   just worker-local          # uses `claude`
#   just worker-local cursor   # uses `agent`
worker-local PROVIDER="claude":
    FORTUNE_PROVIDER={{PROVIDER}} .venv/bin/python -m src.worker

start *ARGS:
    .venv/bin/python -m src.starter {{ARGS}}

interactive *ARGS:
    .venv/bin/python -m src.interactive {{ARGS}}

test:
    .venv/bin/pytest tests/ -v
